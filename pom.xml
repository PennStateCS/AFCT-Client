<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.rit.cs</groupId>
    <artifactId>afct-client</artifactId>
    <version>1.6.9</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyyMMdd-HHmmss</maven.build.timestamp.format>
        <!-- Keep this stable across releases so Windows can identify related products for upgrades. -->
        <windows.upgrade.uuid>5a338032-2203-4f5d-95f2-56ea1d5b4f8b</windows.upgrade.uuid>
        <!--
            The version stamped into the installers. jpackage requires plain numbers here:
            macOS CFBundleVersion and the Windows MSI product version both refuse a suffix,
            so a release candidate built as 1.7.0-rc1 would fail. The release workflow passes
            the numeric part with -Djpackage.app.version; a local build just uses the pom.
        -->
        <jpackage.app.version>${project.version}</jpackage.app.version>
        <jpackage.output.dir>${project.build.directory}/jpackage/${project.version}-${maven.build.timestamp}</jpackage.output.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.16.1</version>
        </dependency>


        <dependency>
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
            <version>64.2</version>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.6</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.8.0</version>
        </dependency>


        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.9</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpmime</artifactId>
            <version>4.5.9</version>
        </dependency>

        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-anim</artifactId>
            <version>1.11</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-svggen</artifactId>
            <version>1.11</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-swing</artifactId>
            <version>1.11</version>
        </dependency>

        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>

        <!-- Typesets the LaTeX in rich problem/assignment descriptions (GPL with
             the linking exception, like GeoGebra ships it). -->
        <dependency>
            <groupId>org.scilab.forge</groupId>
            <artifactId>jlatexmath</artifactId>
            <version>1.0.7</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- JAR plugin - creates basic JAR during compile -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>gui.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.google.code.gson:*</include>
                                    <include>com.google.gson:*</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            <mainClass>gui.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <!-- Execution for jar without version -->
                    <execution>
                        <id>make-assembly-no-version</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>${project.name}</finalName>
                        </configuration>
                    </execution>
                    <!-- Execution for jar with version -->
                    <execution>
                        <id>make-assembly-with-version</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>${project.name}-v${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Native installers. One profile per platform, because jpackage has to run on the
            operating system it is building for and the options are not the same on each:

              Windows:  mvn package -Pjpackage-windows   (needs WiX Toolset 3.x on PATH)
              macOS:    mvn package -Pjpackage-mac

            Neither is signed yet, so Windows shows a SmartScreen warning and macOS refuses
            to open the app until the user allows it in Privacy and Security. Signing is the
            next piece of work and slots in as extra options here plus a step in the release
            workflow; nothing else about this has to change for it.
        -->
        <profile>
            <id>jpackage-windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>AFCT Client</name>
                            <appVersion>${jpackage.app.version}</appVersion>
                            <vendor>RIT CS</vendor>
                            <copyright>RIT CS</copyright>
                            <input>${project.build.directory}</input>
                            <mainJar>afct-client.jar</mainJar>
                            <mainClass>gui.Main</mainClass>
                            <type>EXE</type>
                            <!-- Use a unique destination per build to avoid AccessDenied collisions on a prior EXE in use. -->
                            <destination>${jpackage.output.dir}</destination>
                            <javaOptions>
                                <option>-Xmx512m</option>
                            </javaOptions>
                            <!-- Windows installer options -->
                            <!-- appVersion must increase between releases for in-place upgrade behavior. -->
                            <winDirChooser>true</winDirChooser>
                            <winShortcut>true</winShortcut>
                            <winMenu>true</winMenu>
                            <winMenuGroup>AFCT</winMenuGroup>
                            <winPerUserInstall>true</winPerUserInstall>
                            <winUpgradeUuid>${windows.upgrade.uuid}</winUpgradeUuid>
                            <icon>src/main/resources/afct.ico</icon>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>jpackage-mac</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.5</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>AFCT Client</name>
                            <appVersion>${jpackage.app.version}</appVersion>
                            <vendor>Penn State</vendor>
                            <copyright>Penn State</copyright>
                            <input>${project.build.directory}</input>
                            <mainJar>afct-client.jar</mainJar>
                            <mainClass>gui.Main</mainClass>
                            <!--
                                A disk image, which is what a Mac user expects to download:
                                open it, drag the app across, done. A PKG installer would
                                need its own signing identity to be worth anything.
                            -->
                            <type>DMG</type>
                            <destination>${jpackage.output.dir}</destination>
                            <javaOptions>
                                <option>-Xmx512m</option>
                            </javaOptions>
                            <!--
                                Reverse-DNS, and it must never change: macOS uses it to tell
                                one application from another, so a new identifier reads as a
                                different program and loses the user's settings for this one.
                            -->
                            <macPackageIdentifier>edu.psu.afct.client</macPackageIdentifier>
                            <!-- Kept under 16 characters, which is the menu bar's limit. -->
                            <macPackageName>AFCT Client</macPackageName>
                            <icon>src/main/resources/afct.icns</icon>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Quick build profile - use: mvn compile -Pquick -->
        <profile>
            <id>quick</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <configuration>
                            <skipAssembly>true</skipAssembly>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>